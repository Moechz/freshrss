# ===========================================================================
# Multilingual file for the TOS 7 Docker application "freshrssdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# GENERATED FILE - do not edit by hand. The text lives in tosapp.json
# ("descript", "release_note", "important", "translations") and
# scripts/render-lang.py renders this file during the build.
# ===========================================================================
[en-us]
name         = "FreshRSS"
auth         = "FreshRSS"
version      = "@@VERSION@@"
descript     = "FreshRSS is a self-hosted RSS and Atom feed aggregator. Subscribe to feeds, organise them into categories, search and filter articles, and read them in a clean web UI. An optional API, off by default, connects mobile clients and other apps. This package runs the official Docker Hub image as a non-root container, and the database, users and extensions live in the application data folder."
release_note = "1.31.0-1: rectified per review comments. T1: base image upgraded to FreshRSS 1.31.0, a security release that fixes several critical vulnerabilities. C5: the Help link in the package config.ini now opens the bundled public privacy policy (PRIVACY.md) instead of the issue tracker URL. C8: the policy discloses every outbound endpoint with the data sent and the destination or region (subscribed feeds, favicon fetches, WebSub hubs, the GitHub extension catalogue and extension downloads), plus retention, user rights, security measures and the deletion channel. F5: the description now matches the delivered features (API optional and off by default, no background cron) and the entrypoint now prepares the data directories exactly like the official one, which fixes the first-run installer warnings and the broken favicon / API token storage."
important    = "Open the web UI and complete the first-run page to create the administrator account. There is no default password. Feed data and users live in DockerAppData/freshrssdocker/data, extensions in .../extensions. The image cron is not started in this non-root package, so feeds refresh on demand from the web UI or from an external scheduler. Needs DockerEngine. Back up data before uninstalling with data removal."

[zh-cn]
name         = "FreshRSS"
auth         = "FreshRSS"
version      = "@@VERSION@@"
descript     = "FreshRSS 是一个自托管的 RSS/Atom 订阅聚合器。订阅源、按分类整理、搜索过滤文章，并在清爽的网页界面中阅读。可选 API 默认关闭，可在设置中开启后供手机客户端等程序连接。本应用使用 Docker Hub 官方镜像并以非 root 用户运行；数据库、用户与扩展都保存在应用数据目录。"
release_note = "1.31.0-1：按审核意见整改。基础镜像升级到 FreshRSS 1.31.0（安全版本，修复多个高危漏洞）。帮助链接现在打开随包的公开隐私政策 PRIVACY.md，不再指向 issue 列表。隐私政策逐条列出出网端点、发送的数据与目的地或地区（订阅的订阅源、favicon、WebSub hub、GitHub 扩展目录与扩展下载），并写明保留期、用户权利、安全措施与删除渠道。描述已与实际功能对齐（API 可选、默认关闭，无后台 cron）。启动脚本按官方方式初始化数据目录，修复首次安装页告警与 favicon / API 令牌存储失效的问题。"
important    = "打开网页完成首次安装页，创建管理员账号，没有默认密码。订阅数据与用户保存在 DockerAppData/freshrssdocker/data，扩展在 .../extensions。本非 root 包未启动镜像内置的 cron，订阅需在网页中手动刷新，或用外部定时任务调用刷新接口。需要 DockerEngine。卸载删除数据前请备份 data。"

[zh-hk]
name         = "FreshRSS"
auth         = "FreshRSS"
version      = "@@VERSION@@"
descript     = "FreshRSS 是一個自託管的 RSS/Atom 訂閱聚合器。訂閱源、按分類整理、搜尋過濾文章，並在清爽的網頁介面中閱讀。可選 API 預設關閉，可在設定中開啟後供手機客戶端等程式連接。本應用使用 Docker Hub 官方鏡像並以非 root 使用者運行；資料庫、使用者與擴充都保存在應用資料目錄。"
release_note = "1.31.0-1：按審核意見整改。基礎鏡像升級到 FreshRSS 1.31.0（安全版本，修復多個高危漏洞）。說明連結現在開啟隨包的公開隱私政策 PRIVACY.md，不再指向 issue 清單。隱私政策逐條列出出網端點、發送的資料與目的地或地區（訂閱的訂閱源、favicon、WebSub hub、GitHub 擴充目錄與擴充下載），並寫明保留期、使用者權利、安全措施與刪除渠道。描述已與實際功能對齊（API 可選、預設關閉，無背景 cron）。啟動腳本按官方方式初始化資料目錄，修復首次安裝頁告警與 favicon / API 令牌儲存失效的問題。"
important    = "開啟網頁完成首次安裝頁，建立管理員帳號，沒有預設密碼。訂閱資料與使用者保存在 DockerAppData/freshrssdocker/data，擴充在 .../extensions。本非 root 包未啟動鏡像內建的 cron，訂閱需在網頁中手動重新整理，或用外部定時任務呼叫重新整理介面。需要 DockerEngine。解除安裝刪除資料前請備份 data。"

[fr-fr]
