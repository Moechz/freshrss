# ===========================================================================
# Multilingual file for the TOS 7 Docker application "freshrssdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "FreshRSS"
auth         = "FreshRSS"
version      = "@@VERSION@@"
descript     = "FreshRSS is a self-hosted RSS and Atom feed aggregator. Subscribe to feeds, organize them into categories, search and filter articles, and read them in a clean web UI or through the API and mobile clients. This package runs the official Docker Hub image as a non-root container; the database, users and extensions live in the application data folder."
release_note = "1. First release: FreshRSS 1.30.4 from Docker Hub, x86_64 + aarch64, non-root."
important    = "Open the web UI and complete the first-run page to create the administrator account; there is no default password. Feed data and users live in DockerAppData/freshrssdocker/data, extensions in .../extensions. Automatic feed refresh is disabled in this non-root package; use the web UI refresh or an external scheduler. Needs DockerEngine; add a registry mirror if Docker Hub is unreachable. Back up data before uninstalling with data removal. Plain HTTP on the LAN."

[zh-cn]
name         = "FreshRSS"
auth         = "FreshRSS"
version      = "@@VERSION@@"
descript     = "FreshRSS 是一个自托管的 RSS/Atom 订阅聚合器。订阅源、按分类整理、搜索过滤文章，并通过清爽的网页界面、API 或手机客户端阅读。本应用使用 Docker Hub 官方镜像并以非 root 用户运行；数据库、用户与扩展都保存在应用数据目录。"
release_note = "1. 首个版本：FreshRSS 1.30.4，来自 Docker Hub，x86_64 + aarch64 双包，非 root。"
important    = "打开网页完成首次安装页，创建管理员账号；没有默认密码。订阅数据与用户保存在 DockerAppData/freshrssdocker/data，扩展在 .../extensions。镜像每 20 分钟刷新一次订阅。需要 DockerEngine；无法访问 Docker Hub 时请先配置镜像加速。卸载删除数据前请备份 data。应用通过局域网 HTTP 访问。"

[zh-hk]
name         = "FreshRSS"
auth         = "FreshRSS"
version      = "@@VERSION@@"
descript     = "FreshRSS 是一個自託管的 RSS/Atom 訂閱聚合器。訂閱源、按分類整理、搜尋過濾文章，並透過清爽的網頁介面、API 或手機客戶端閱讀。本應用使用 Docker Hub 官方鏡像並以非 root 使用者運行；資料庫、使用者與擴充都保存在應用資料目錄。"
release_note = "1. 首個版本：FreshRSS 1.30.4，來自 Docker Hub，x86_64 + aarch64 雙包，非 root。"
important    = "開啟網頁完成首次安裝頁，建立管理員帳號；沒有預設密碼。訂閱資料與使用者保存在 DockerAppData/freshrssdocker/data，擴充在 .../extensions。鏡像每 20 分鐘刷新一次訂閱。需要 DockerEngine；無法存取 Docker Hub 時請先設定鏡像加速。解除安裝刪除資料前請備份 data。應用透過局域網 HTTP 存取。"

